<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="BsDiff" Version="1.1.0" />
      <PackageReference Include="LanguageExt.Core" Version="4.4.9" />
      <PackageReference Include="MessageStudio" Version="1.1.1" />
      <PackageReference Include="Revrs" Version="2.1.1" />
      <PackageReference Include="RstbLibrary" Version="1.0.2" />
      <PackageReference Include="BfresLibrary" Version="1.6.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\TkSharp.Core\TkSharp.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Resources\**" />
    </ItemGroup>

    <ItemGroup>
      <Using Include="TkSharp.Core.Common" />
    </ItemGroup>

    <PropertyGroup Condition="'$(EnableExperimentalAinb)' == 'true'">
      <DefineConstants>$(DefineConstants);EXPERIMENTAL_AINB</DefineConstants>
    </PropertyGroup>
    <ItemGroup Condition="'$(EnableExperimentalAinb)' == 'true'">
      <ProjectReference Include="..\experimental\AinbModel.Contract\AinbModel.Contract.csproj" />
    </ItemGroup>
    <ItemGroup Condition="'$(EnableExperimentalAinb)' != 'true'">
      <Compile Remove="Mergers\Ainb\**\*.cs" />
    </ItemGroup>
    <Target Name="RejectExperimentalAinbPackage" BeforeTargets="GenerateNuspec" Condition="'$(EnableExperimentalAinb)' == 'true'">
      <Error Text="The experimental AINB contract is not a published dependency. Complete the codec/package handoff before packing this configuration." />
    </Target>

</Project>
